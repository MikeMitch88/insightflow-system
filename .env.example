# ============================================================
# Database Configuration (PostgreSQL / Supabase)
# ============================================================
DATABASE_URL=postgresql://postgres:postgres_password@postgres:5432/insightful_system
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres_password
POSTGRES_DB=insightful_system

# ============================================================
# AI Configuration (OpenAI or Groq)
# ============================================================
AI_API_KEY=
AI_MODEL=gpt-4
AI_BASE_URL=https://api.openai.com/v1

# Groq Alternative (set GROQ_API_KEY to use Groq instead of OpenAI)
GROQ_API_KEY=
GROQ_MODEL=llama-3.1-70b-versatile

# ============================================================
# JWT & Auth
# ============================================================
JWT_SECRET=change-this-in-production
SHARED_PASSWORD=Admin@123

# ============================================================
# FAISS Vector Store
# ============================================================
FAISS_INDEX_PATH=./data/faiss_index
FAISS_CHUNK_SIZE=512
FAISS_CHUNK_OVERLAP=50

# ============================================================
# CORS Origins
# ============================================================
ALLOWED_ORIGINS=http://localhost:4200,http://127.0.0.1:4200,http://localhost:8080,http://localhost:3000

# ============================================================
# Report Export
# ============================================================
REPORT_EXPORT_DIR=./data/reports
